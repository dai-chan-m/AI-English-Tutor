# 本番URL（sitemap・OGP・canonicalに使用）
NEXT_PUBLIC_SITE_URL=https://ai-english-tutor.xyz

# Google AdSenseのクライアントID（例: ca-pub-XXXXXXXXXXXXXXXX）
# 未設定の場合、本番では広告枠が非表示になる
NEXT_PUBLIC_ADSENSE_CLIENT=

# Google Analytics 4の測定ID（例: G-XXXXXXXXXX）
NEXT_PUBLIC_GA_ID=

# StripeのPayment Link（Proプラン月額サブスクリプション）
# 決済成功時のリダイレクト先を https://<ドメイン>/pro/thanks に設定すること
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=

# お問い合わせページに表示するメールアドレス
NEXT_PUBLIC_CONTACT_EMAIL=
